    "material-analysis",
    "narrative",
    "captions",
    "qa"
  ],
  "quality_rules": [
    "核心情节完整，动作和空间连续",
    "计划边界正确；导出媒体与可编辑工程分别验收。"
  ],
  "anti_patterns": [
    "切镜破坏人物位置关系",
    "所有镜头机械等长"
  ],
  "fallback": "素材证据不足则标缺；官方能力未验证则 blocked，不切换编辑引擎。",
