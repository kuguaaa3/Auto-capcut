  "not_suitable_for": "需要虚构情绪或不存在动作才能成立的故事",
  "inputs": [
    "可读取且允许使用的素材",
    "实际内容证据或用户明确标注",
    "目标时长与画幅"
  ],
  "default_behavior": "用户显式要求优先；按素材证据调整节奏，不机械套用固定镜头秒数。",
